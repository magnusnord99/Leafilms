# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Superpowers temp files
.superpowers/brainstorm/
.superpowers/sdd/
supabase/.temp/

# Git worktrees
.worktrees/

# google-github-actions/auth writes exported credentials here, in the repo
# working directory — must stay untracked or the nightly-feedback workflow's
# clean-tree check (see .github/prompts/nightly-feedback.md step 1) never
# passes.
gha-creds-*.json
